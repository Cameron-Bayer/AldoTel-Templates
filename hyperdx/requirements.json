{
  "_comment": "Drives preflight.ps1/.sh (compatibility check) and documents per-dashboard requirements. tier is \"default\" (always populated on a full appliance deploy) or \"advanced\" (opt-in, needs optional data sources; imported only with -Advanced/--advanced). metricType maps to the otel_metrics_<type> table. required=false tiles degrade gracefully if the metric is absent. Every metric listed here has been verified against a real appliance deployment; metrics the appliance does not emit are deliberately not listed.",
  "dashboards": [
    {
      "file": "operations-center.json",
      "tmpl": "tmpl:operations-center",
      "tier": "default",
      "name": "Operations Center",
      "receivers": [
        "Cross-cutting roll-up: application traces (OTLP), application/container logs, Kubernetes metrics (kubeletstats + k8s_cluster + k8sobjects events), and host metrics (hostmetrics). Every tile degrades gracefully when a signal is absent."
      ],
      "checks": [
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "k8s.node.condition_ready"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "system.cpu.utilization"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "system.memory.utilization"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.filesystem.usage"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.network.io"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "k8s.pod.phase"
        },
        {
          "kind": "trace",
          "required": false,
          "label": "server spans",
          "where": "SpanKind:Server"
        },
        {
          "kind": "log",
          "required": false,
          "label": "log volume",
          "where": ""
        }
      ]
    },
    {
      "file": "infrastructure.json",
      "tmpl": "tmpl:infrastructure",
      "tier": "default",
      "name": "Infrastructure",
      "receivers": [
        "hostmetrics receiver (system.* scrapers: cpu, memory, load, swap, disk, network)",
        "kubeletstats + k8s_cluster receivers (k8s.node.* for node/cluster health and filesystem)"
      ],
      "checks": [
        {
          "kind": "metric",
          "required": true,
          "metricType": "gauge",
          "metricName": "system.cpu.utilization"
        },
        {
          "kind": "metric",
          "required": true,
          "metricType": "gauge",
          "metricName": "system.memory.utilization"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.filesystem.inodes.usage"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "system.cpu.load_average.1m"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.disk.io"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.disk.operations"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.disk.operation_time"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.network.io"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.network.dropped"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.network.errors"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "k8s.node.condition_ready"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.filesystem.usage"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.memory.usage"
        }
      ]
    },
    {
      "file": "kubernetes.json",
      "tmpl": "tmpl:kubernetes",
      "tier": "default",
      "name": "Kubernetes",
      "receivers": [
        "kubeletstats receiver",
        "k8s_cluster receiver",
        "k8sobjects receiver (events.k8s.io) for the cluster-events tiles"
      ],
      "checks": [
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "system.cpu.utilization"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "system.memory.utilization"
        },
        {
          "kind": "metric",
          "required": true,
          "metricType": "gauge",
          "metricName": "k8s.deployment.available"
        },
        {
          "kind": "metric",
          "required": true,
          "metricType": "gauge",
          "metricName": "k8s.deployment.desired"
        },
        {
          "kind": "metric",
          "required": true,
          "metricType": "gauge",
          "metricName": "k8s.pod.phase"
        },
        {
          "kind": "metric",
          "required": true,
          "metricType": "gauge",
          "metricName": "k8s.container.restarts"
        },
        {
          "kind": "metric",
          "required": true,
          "metricType": "gauge",
          "metricName": "k8s.pod.memory.usage"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.filesystem.usage"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "k8s.pod.cpu_limit_utilization"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "k8s.pod.memory_limit_utilization"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "k8s.node.condition_ready"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "k8s.pod.cpu.usage"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "k8s.namespace.phase"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "k8s.pod.uptime"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "k8s.node.uptime"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "k8s.container.cpu_limit_utilization"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "k8s.container.memory_limit_utilization"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "container.uptime"
        },
        {
          "kind": "log",
          "required": false,
          "label": "cluster events (k8sobjects)",
          "where": "ScopeName:*k8sobjectsreceiver*"
        }
      ]
    },
    {
      "file": "services.json",
      "tmpl": "tmpl:services",
      "tier": "default",
      "name": "Services (RED)",
      "receivers": [
        "Application traces (OTLP)"
      ],
      "checks": [
        {
          "kind": "trace",
          "required": true,
          "label": "server spans",
          "where": "SpanKind:Server"
        },
        {
          "kind": "trace",
          "required": false,
          "label": "error spans",
          "where": "SpanKind:Server AND StatusCode:Error"
        },
        {
          "kind": "trace",
          "required": false,
          "label": "client/dependency spans",
          "where": "SpanKind:Client"
        }
      ]
    },
    {
      "file": "logs.json",
      "tmpl": "tmpl:logs",
      "tier": "default",
      "name": "Logs",
      "receivers": [
        "Application/container logs (filelog or OTLP)"
      ],
      "checks": [
        {
          "kind": "log",
          "required": true,
          "label": "log volume",
          "where": ""
        },
        {
          "kind": "log",
          "required": false,
          "label": "error logs",
          "where": "SeverityNumber:>=17 OR SeverityText:error OR SeverityText:fatal"
        }
      ]
    },
    {
      "file": "supportability.json",
      "tmpl": "tmpl:supportability",
      "tier": "default",
      "name": "Supportability",
      "receivers": [
        "Application/container logs, application traces (OTLP), and Kubernetes metrics + events (kubeletstats + k8s_cluster + k8sobjects). Alert-condition tiles recompute rules live; there is no separate alert-state store."
      ],
      "checks": [
        {
          "kind": "log",
          "required": false,
          "label": "log volume",
          "where": ""
        },
        {
          "kind": "trace",
          "required": false,
          "label": "server spans",
          "where": "SpanKind:Server"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "k8s.pod.phase"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "k8s.container.restarts"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "system.cpu.utilization"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "system.memory.utilization"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "system.filesystem.usage"
        },
        {
          "kind": "log",
          "required": false,
          "label": "cluster events (k8sobjects)",
          "where": "ScopeName:*k8sobjectsreceiver*"
        }
      ]
    },
    {
      "file": "observability-platform-health.json",
      "tmpl": "tmpl:observability-platform",
      "tier": "advanced",
      "name": "Observability Platform Health",
      "receivers": [
        "OTel Collector internal telemetry scraped into OTel (Prometheus receiver on the collector's :8888 self-metrics)",
        "ClickHouse metrics scraped into OTel (Prometheus/clickhouse receiver)",
        "ClickHouse workload, merge, mutation, cache, insert, retention, and query-performance tiles use Raw SQL — the HyperDX ClickHouse connection user must be able to SELECT from system.query_log, system.parts, system.merges, and system.mutations, and query_log must be enabled"
      ],
      "checks": [
        {
          "kind": "metric",
          "required": true,
          "metricType": "sum",
          "metricName": "otelcol_receiver_accepted_spans_total"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "otelcol_exporter_queue_size"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "otelcol_exporter_queue_capacity"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "otelcol_receiver_accepted_log_records_total"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "otelcol_receiver_accepted_metric_points_total"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "ClickHouseMetrics_Query"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "sum",
          "metricName": "ClickHouseProfileEvents_FailedQuery"
        },
        {
          "kind": "metric",
          "required": false,
          "metricType": "gauge",
          "metricName": "ClickHouseMetrics_MemoryTracking"
        }
      ]
    }
  ]
}
