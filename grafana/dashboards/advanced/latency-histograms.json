{
  "uid": "clickstack-latency-histograms",
  "title": "ClickStack - Services (Latency Histograms)",
  "description": "Advanced companion to Service Health: request latency from OpenTelemetry explicit-bucket histogram metrics (otel_metrics_histogram) — average latency (delta Sum / delta Count) and request rate for HTTP server/client and RPC server calls. Only useful if your applications emit OTLP histogram metrics.",
  "tags": [
    "clickstack",
    "opentelemetry"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
