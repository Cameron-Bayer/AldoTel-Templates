      "description": "Incoming HTTP request count in each Grafana time bucket for each service. Bucket duration changes with the dashboard time range.",
      "interval": "1m"
    },
    {
      "id": null,
      "type": "row",
      "title": "Service & request type",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
